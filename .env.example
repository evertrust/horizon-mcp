# Horizon MCP server configuration.
# Copy this file to .env.local.
# Change the values for your environment.

# === Required ===
HORIZON_URL=https://horizon.example.com

# === Authentication (detected from the variables you set) ===
# Configure exactly one complete method. Startup fails closed otherwise.

# Option 1: API key. Set both variables.
HORIZON_API_ID=<your-api-id>
HORIZON_API_KEY=<your-api-key>

# Option 2: mTLS with PEM files
# HORIZON_CLIENT_CERT=/path/to/client.crt
# HORIZON_CLIENT_KEY=/path/to/client.key
# HORIZON_CLIENT_KEY_PASSWORD=<optional-key-password>

# Option 3: mTLS with PKCS12 / PFX
# HORIZON_CLIENT_PFX=/path/to/client.p12
# HORIZON_CLIENT_PFX_PASSWORD=<optional-pfx-password>

# Option 4: service account
# HORIZON_SERVICE_ACCOUNT=<your-service-account-name>
# Set an initial token. Omit it only when the OAuth client pair below is set
# and HORIZON_OAUTH_ISSUERS pins exactly one issuer. Stdio then mints the
# first token at startup. If minting fails, stdio logs a sanitized error and
# keeps serving, and tool calls retry after the 30-second cooldown. HTTP mode
# is unchanged and always needs X-API-TOKEN.
# HORIZON_API_TOKEN=<your-initial-jwt>
# Optional OAuth renewal settings. Set the client ID and the secret together:
# HORIZON_OAUTH_CLIENT_ID=<your-oauth-client-id>
# HORIZON_OAUTH_CLIENT_SECRET=<your-oauth-client-secret>
# HORIZON_OAUTH_SCOPE=horizon.read
# HORIZON_OAUTH_AUDIENCE=horizon-api
# HORIZON_OAUTH_ISSUERS='{"https://issuer.example.com":{"tokenUrl":"https://issuer.example.com/oauth/token","authMethod":"client_secret_basic"}}'

# DEPRECATED - no longer needed, kept for backward compatibility.
# The server logs a warning if you set it.
# HORIZON_AUTH_MODE=

# === Optional - TLS and timeouts ===
HORIZON_VERIFY_SSL=true
HORIZON_TIMEOUT=30
HORIZON_EXPORT_TIMEOUT=120

# === Optional - logging and version compatibility ===
HORIZON_LOG_LEVEL=INFO
# Comma-separated list of Horizon versions known to fully work with this build.
# HORIZON_TESTED_VERSIONS=2.10
# Comma-separated list of versions that probably work.
# The server logs a warning when it connects to one of them.
# HORIZON_WARN_VERSIONS=2.8,2.9

# === Optional - streamable HTTP transport ===
# Set HORIZON_TRANSPORT=http to serve over HTTP instead of stdio.
# Deploy one MCP instance per Horizon. The backend is always HORIZON_URL above.
# HORIZON_TRANSPORT=http
# HORIZON_HTTP_HOST=127.0.0.1            # 0.0.0.0 only behind a trusted edge
# HORIZON_HTTP_PORT=8080
# HORIZON_HTTP_PATH=/mcp
# Comma- or pipe-separated whitelist: api-key, mtls, service.
# HORIZON_HTTP_AUTH_METHODS=api-key,service
# A non-loopback bind needs one of these. Startup fails closed without them:
# HORIZON_PUBLIC_URL=https://mcp.example.com
# HORIZON_TRUSTED_HOSTS=mcp.example.com
# HORIZON_TRUSTED_ORIGINS=https://app.example.com   # only for browser callers
# Maximum simultaneous non-listen requests. Default 32, hard ceiling 256.
# HORIZON_MAX_CONCURRENT_REQUESTS=32
# HORIZON_MAX_INFLIGHT_TOOLCALLS=8
# Inbound mTLS, for when mtls is whitelisted. Pick one termination topology:
# HORIZON_HTTP_TLS_CERT=/path/to/listener.crt
# HORIZON_HTTP_TLS_KEY=/path/to/listener.key
# HORIZON_INBOUND_CERT_HEADER=x-forwarded-client-cert
# HORIZON_TRUSTED_PROXY=10.0.0.0/8
# HORIZON_FORWARD_CERT_HEADER=SSL_CLIENT_CERT

# === Development / testing only (never read by the server itself) ===
# HORIZON_E2E_URL=https://qa.horizon.example.com
# HORIZON_E2E_API_ID=<your-e2e-api-id>
# HORIZON_E2E_API_KEY=<your-e2e-api-key>
# HORIZON_E2E_SVA=<your-e2e-service-account-name>
# HORIZON_E2E_SVA_TOKEN=<your-e2e-service-account-jwt>
# Or, instead of a static token, use the Entra ID app registration that the
# account trusts. The E2E leg mints the token and tests pinned-issuer renewal:
# HORIZON_E2E_OAUTH_TENANT=<directory-tenant-id>
# HORIZON_E2E_OAUTH_CLIENT_ID=<application-client-id>
# HORIZON_E2E_OAUTH_CLIENT_SECRET=<client-secret>
# HORIZON_E2E_OAUTH_SCOPE=<application-client-id>/.default
# HORIZON_LLM_LIVE_MODEL=claude-sonnet-4-6
