# Horizon MCP Server Configuration
HORIZON_URL=https://horizon.example.com

# === Authentication (auto-detected from which variables are set) ===
# Priority: mTLS > API Key > OIDC browser

# Option 1: API Key (set both)
HORIZON_API_ID=your-api-id
HORIZON_API_KEY=your-api-key

# Option 2: mTLS with PEM files
# HORIZON_CLIENT_CERT=/path/to/client.crt
# HORIZON_CLIENT_KEY=/path/to/client.key
# HORIZON_CLIENT_KEY_PASSWORD=optional-key-password

# Option 3: mTLS with PKCS12/PFX
# HORIZON_CLIENT_PFX=/path/to/client.p12
# HORIZON_CLIENT_PFX_PASSWORD=optional-pfx-password

# Option 4: OIDC browser session
# Just set HORIZON_URL — a browser window opens for login at startup

# === Optional ===
HORIZON_VERIFY_SSL=true
HORIZON_TIMEOUT=30
HORIZON_LOG_LEVEL=INFO
