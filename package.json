{
  "name": "horizon-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for Evertrust Horizon certificate lifecycle management",
  "type": "module",
  "bin": {
    "horizon-mcp": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "build:binary": "npm run build && bun build --compile dist/index.js --outfile dist/horizon-mcp --external playwright",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts --reporter=verbose",
    "test:llm": "vitest run --config vitest.config.llm.ts --reporter=verbose",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "undici": "8.0.1",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "playwright": "1.59.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "25.5.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "4.1.2"
  }
}
